# Data: raw OpenFEMA downloads are large and frozen locally (see data/raw/MANIFEST, which is committed)
data/raw/*
!data/raw/MANIFEST
# Processed data and simulations are regenerated by `make all`
data/processed/*
!data/processed/.gitkeep

# Excel lock files
~$*.xlsx
